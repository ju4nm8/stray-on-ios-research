[SystemSettings]
; Disable hardware occlusion queries and HZB occlusion to avoid GPU synchronization stall
r.HZBOcclusion=0
r.AllowOcclusionQueries=0

; Render scene early depth pass
r.EarlyZPass=1

; Exposure bias settings (compensates for dynamic exposure stalls)
r.EyeAdaptation.ExposureBias=1.6
DefaultFeatureAutoExposureBias=1.6

; Texture streaming pool configuration (2 GB on Apple Silicon unified memory)
r.TextureStreaming=1
r.Streaming.PoolSize=2048
r.Streaming.FullyLoadUsedTextures=1

; Force fallback from SubsurfaceProfile to Lambertian DefaultLit for troubleshooting
r.SubsurfaceScattering=0

[PlatformCrypto]
PlatformRequiresCrypto=False
