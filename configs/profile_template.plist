<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Application Identifier: replace <APPLE_TEAM_ID> and <BUNDLE_ID> -->
    <key>application-identifier</key>
    <string><APPLE_TEAM_ID>.<BUNDLE_ID></string>

    <key>com.apple.developer.team-identifier</key>
    <string><APPLE_TEAM_ID></string>

    <!-- Debugging capability on device -->
    <key>get-task-allow</key>
    <true/>

    <key>keychain-access-groups</key>
    <array>
        <string><APPLE_TEAM_ID>.*</string>
    </array>

    <!-- Optional: Increased memory limit entitlement for heavy Unreal Engine allocations -->
    <!-- Requires support in provisioning profile from Apple Developer account -->
    <!--
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
    -->
</dict>
</plist>
